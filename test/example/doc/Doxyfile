##======================================================================================================================
## Only what belongs to this project. Everything the fleet shares - the theme, the aliases, what a reference page shows -
## comes from the @INCLUDE at the bottom, and anything not named anywhere is a doxygen default we have no reason to
## restate.
##======================================================================================================================

## Where it reads and writes
OUTPUT_DIRECTORY       = $(DOXYGEN_OUPUT)
HTML_OUTPUT            = ./
INPUT                  = ../src .
INCLUDE_PATH           = ../src

## Its own detail namespace, hidden the way the fleet hides its own
INPUT_FILTER           = "python3 $(DOXYGEN_ASSETS)/filter.py --prefix example"
PREDEFINED             = DOXYGEN_INVOKED

## Its own reading choices
SEPARATE_MEMBER_PAGES  = YES
TOC_INCLUDE_HEADINGS   = 0

##======================================================================================================================
## What the fleet shares, last so that it wins over anything above
##======================================================================================================================
@INCLUDE               = $(DOXYGEN_ASSETS)/base.doxyfile

## What this project adds on top of it. color.css is written into the output by copa_setup_doxygen, from the same
## numbers that tint doxygen's own widgets.
HTML_EXTRA_STYLESHEET += $(DOXYGEN_ASSETS)/custom.css
HTML_EXTRA_STYLESHEET += $(DOXYGEN_OUPUT)/color.css
